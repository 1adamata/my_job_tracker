{
  "manifest_version": 3,
  "name": "Job Queue Capture",
  "version": "1.0.0",
  "description": "Instantly save the current job page to your local processing queue.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "action": {"default_title": "Add job to queue", "default_popup": "popup.html"}
}
